{
  "name": "sk-v27-LW1-smoke",
  "note": "Smoke corpus for LW1.RX-1. Offsets `at` are UTF-8 byte offsets. Inputs are valid Unicode scalar-value strings. The rx2-* cases are the LW1.RX-2 born-RED cases; their oracle answers are the expected values the Rust tests assert.",
  "cases": [
    { "id": "rx2-c1-1-neg-lookahead", "pattern": "\\d+(?!\\.\\d)", "flags": "", "input": "12.5" },
    { "id": "rx2-c1-1-neg-lookahead-u", "pattern": "\\d+(?!\\.\\d)", "flags": "u", "input": "12.5" },
    { "id": "rx2-c1-1-int", "pattern": "\\d+(?!\\.\\d)", "flags": "", "input": "12" },
    { "id": "rx2-alt-a-ab", "pattern": "a|ab", "flags": "", "input": "ab" },
    { "id": "rx2-alt-a-ab-u", "pattern": "a|ab", "flags": "u", "input": "ab" },
    { "id": "rx2-alt-ab-a", "pattern": "ab|a", "flags": "", "input": "ab" },
    { "id": "rx2-absorb-e-acute-in-e-acute", "pattern": "[é]", "flags": "u", "input": "é" },
    { "id": "rx2-absorb-e-acute-in-greek", "pattern": "[α-ω]", "flags": "u", "input": "é" },
    { "id": "rx2-absorb-beta-in-e-acute", "pattern": "[é]", "flags": "u", "input": "β" },
    { "id": "rx2-absorb-alt-e-greek-on-e", "pattern": "[α-ω]|[é]", "flags": "u", "input": "é" },
    { "id": "rx2-absorb-order-run-first", "pattern": "[a-c]+|[a-z]", "flags": "", "input": "abc" },
    { "id": "rx2-absorb-order-class-first", "pattern": "[a-z]|[a-c]+", "flags": "", "input": "abc" },
    { "id": "rx2-kelvin-k-i", "pattern": "k", "flags": "i", "input": "K" },
    { "id": "rx2-kelvin-k-iu", "pattern": "k", "flags": "iu", "input": "K" },
    { "id": "rx2-kelvin-K-iu", "pattern": "K", "flags": "iu", "input": "K" },
    { "id": "rx2-kelvin-sign-i-on-k", "pattern": "\\u212a", "flags": "i", "input": "k" },
    { "id": "rx2-kelvin-sign-iu-on-k", "pattern": "\\u212a", "flags": "iu", "input": "k" },
    { "id": "rx2-long-s-iu-on-s", "pattern": "ſ", "flags": "iu", "input": "s" },
    { "id": "rx2-long-s-i-on-s", "pattern": "ſ", "flags": "i", "input": "s" },
    { "id": "rx2-e-acute-i-on-E-acute", "pattern": "é", "flags": "i", "input": "É" },
    { "id": "rx2-e-acute-iu-on-E-acute", "pattern": "é", "flags": "iu", "input": "É" },
    { "id": "probe-dollar-mid", "pattern": "foo$", "flags": "", "input": "foobar" },
    { "id": "probe-dollar-end", "pattern": "foo$", "flags": "", "input": "foo" },
    { "id": "probe-lazy-star", "pattern": "a*?", "flags": "", "input": "aaa" },
    { "id": "probe-word-boundary", "pattern": "\\bfoo", "flags": "", "input": "foo" },
    { "id": "probe-group-alt", "pattern": "(a|ab)(c|bcd)", "flags": "", "input": "abcd" },
    { "id": "enc-dot-astral-non-u", "pattern": ".", "flags": "", "input": "😀" },
    { "id": "enc-dot-astral-u", "pattern": ".", "flags": "u", "input": "😀" },
    { "id": "enc-negclass-astral-non-u", "pattern": "[^a]", "flags": "", "input": "😀" },
    { "id": "enc-negclass-astral-u", "pattern": "[^a]", "flags": "u", "input": "😀" },
    { "id": "enc-offset-after-2byte", "pattern": "\\d+", "flags": "", "input": "é12", "at": 2 },
    { "id": "enc-offset-after-astral", "pattern": "\\d+", "flags": "u", "input": "😀12", "at": 4 },
    { "id": "enc-word-e-acute-non-u", "pattern": "\\w", "flags": "", "input": "é" },
    { "id": "enc-word-e-acute-iu", "pattern": "\\w", "flags": "iu", "input": "é" },
    { "id": "v-class-difference", "pattern": "[\\p{L}--[a-z]]", "flags": "v", "input": "é" },
    { "id": "v-class-difference-ascii", "pattern": "[\\p{L}--[a-z]]", "flags": "v", "input": "q" },
    { "id": "u-property-letter", "pattern": "\\p{L}+", "flags": "u", "input": "αβγ1" },
    { "id": "css-hex-lookahead", "pattern": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![\\w-])", "flags": "", "input": "#fff;" },
    { "id": "css-hex-lookahead-reject", "pattern": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![\\w-])", "flags": "", "input": "#fffg" },
    { "id": "css-func-lookahead", "pattern": "(?:--[\\w-]*|[a-zA-Z_-][\\w-]*)(?=\\()", "flags": "", "input": "rgb(1 2 3)" },
    { "id": "css-lookbehind", "pattern": "(?<=\\*)", "flags": "", "input": "*a", "at": 1 }
  ]
}
