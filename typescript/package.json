{
    "name": "@mkbabb/parse-that",
    "version": "0.13.0",
    "description": "Parser combinators for TypeScript",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/parse.js",
            "require": "./dist/parse.cjs"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js",
            "require": "./dist/core.cjs"
        },
        "./diagnostics": {
            "types": "./dist/diagnostics.d.ts",
            "import": "./dist/diagnostics.js",
            "require": "./dist/diagnostics.cjs"
        },
        "./packrat": {
            "types": "./dist/packrat-entry.d.ts",
            "import": "./dist/packrat.js",
            "require": "./dist/packrat.cjs"
        },
        "./utils": {
            "types": "./dist/utils-entry.d.ts",
            "import": "./dist/utils.js",
            "require": "./dist/utils.cjs"
        }
    },
    "scripts": {
        "test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
        "test:watch": "vitest",
        "build": "vite build",
        "bench": "vitest bench",
        "proof:manifest": "node test/manifest-gate.mjs",
        "proof:no-css-surface": "node scripts/proof-no-css-surface.mjs",
        "proof:subpath": "node test/subpath-gate.mjs",
        "proof:packrat-cross-input": "node scripts/proof-packrat-cross-input.mjs",
        "proof:packrat-reentrant": "node scripts/proof-packrat-reentrant.mjs",
        "proof:packrat-large-offset": "node scripts/proof-packrat-large-offset.mjs",
        "proof:span-parser-killed": "node scripts/proof-span-parser-killed.mjs",
        "proof:span-surface-resolved": "node scripts/proof-span-surface-resolved.mjs",
        "proof:no-dead-combinator": "node scripts/proof-no-dead-combinator.mjs",
        "proof:perf": "NODE_OPTIONS='--expose-gc' node scripts/proof-perf.mjs",
        "proof:all": "npm run proof:manifest && npm run proof:no-css-surface && npm run proof:subpath && npm run proof:packrat-cross-input && npm run proof:packrat-reentrant && npm run proof:packrat-large-offset && npm run proof:span-parser-killed && npm run proof:span-surface-resolved && npm run proof:no-dead-combinator && npm run proof:perf"
    },
    "files": [
        "./dist"
    ],
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/parsimmon": "^1.10.9",
        "arcsecond": "^5.0.0",
        "chevrotain": "^11.1.1",
        "moo": "^0.5.2",
        "nearley": "^2.20.1",
        "ohm-js": "^17.5.0",
        "parjs": "^1.3.9",
        "parsimmon": "^1.18.1",
        "peggy": "^5.0.6",
        "typescript": "^5.8.0",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^3.2.0"
    }
}
